# Entorno aislado de QA. No toca eduarchive ni eduarchive_test.
NODE_ENV=test
PORT=4100
LOG_LEVEL=silent
CORS_ORIGINS=http://localhost:3000,http://localhost:4100
DATABASE_URL=postgresql://postgres:CONTRASENA@localhost:5432/eduarchive_qa
DATABASE_URL_TEST=postgresql://postgres:CONTRASENA@localhost:5432/eduarchive_qa
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
APP_ENCRYPTION_KEY=
SEED_ADMIN_EMAIL=qa.admin@eduarchive.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=QA Administrador
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BASE_FOLDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ALLOW_DB_RESET=false
ENABLE_JOBS=false
APP_VERSION=qa
