# ── Servidor ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Base de datos (PostgreSQL 17 local) ───────────────────
DATABASE_URL=postgres://postgres:CONTRASENA@localhost:5432/eduarchive
DATABASE_URL_TEST=postgres://postgres:CONTRASENA@localhost:5432/eduarchive_test

# ── Seguridad ─────────────────────────────────────────────
# Generados automáticamente por `npm run setup:env`
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
# 32 bytes en base64 — cifra los secretos guardados en system_config
APP_ENCRYPTION_KEY=

# ── Administrador inicial (usado por `npm run db:seed`) ────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# ── Gemini (opcional; sin clave la IA queda deshabilitada) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── SMTP (opcional; también configurable desde /system/config) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── AWS S3 (opcional; preferible configurarlo en /system/config) ─
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BASE_FOLDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Operación ─────────────────────────────────────────────
# true habilita `npm run db:reset` (destructivo)
ALLOW_DB_RESET=false
# false desactiva los jobs programados (útil en pruebas)
ENABLE_JOBS=true
